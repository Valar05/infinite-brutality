  "starter_fragment_templates": [
    {
      "id": "rule_fragment",
      "channel": "inscription",
      "example_shape": "Do not {action} before {condition}.",
      "best_for": [
        "shelter",
        "shrine",
        "burial"
      ]
    },
    {
      "id": "tally_fragment",
      "channel": "tally_system",
      "example_shape": "{count_group}:{count_mark} beside {resource_or_person}.",
      "best_for": [
        "ration",
        "burial",
        "shelter"
      ]
    },
    {
      "id": "vow_fragment",
      "channel": "chalk_note",
      "example_shape": "If {mercy_or_escape}, then {offering_or_obligation}.",
      "best_for": [
        "shrine",
        "burial"
      ]
    },
    {
      "id": "substitution_fragment",
      "channel": "scratched_mark",
      "example_shape": "Use {replacement} for {lost_original}.",
      "best_for": [
        "repair",
        "ration",
        "shrine"
      ]
    },
    {
      "id": "warning_fragment",
      "channel": "reused_official_plaque",
      "example_shape": "{route_or_object} unsafe after {trigger}.",
      "best_for": [
        "repair",
        "ration",
        "shelter"
      ]
    },
    {
      "id": "memorial_fragment",
      "channel": "inscription",
      "example_shape": "{name_or_role}, {age_or_count}, {remembrance_clause}.",
      "best_for": [
        "burial",
        "shrine"
      ]
    },
    {
      "id": "child_copy_fragment",
      "channel": "chalk_note",
      "example_shape": "I will {rule_or_prayer} repeated in uneven lines.",
      "best_for": [
        "shelter",
        "shrine"
      ]
    },
    {
      "id": "route_fragment",
      "channel": "icon_sequence",
      "example_shape": "{safe_mark} toward {destination}; {crossed_mark} toward {false_destination}.",
      "best_for": [
        "repair",
        "shelter",
        "ration"
      ]
    },
    {
      "id": "work_fragment",
      "channel": "scratched_mark",
      "example_shape": "{step_one}, {step_two}, {step_three} with one step crossed out or incomplete.",
      "best_for": [
        "repair",
        "ration"
      ]
    },
    {
      "id": "absence_fragment",
      "channel": "absence_or_interruption",
      "example_shape": "Expected {object_or_name} missing where the pattern says it should be.",
      "best_for": [
        "all"
      ]
    }
  ]

      "packet_id": "hg_np_07_toll_icon_shelf",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "The toll ledger ended at the poisoning.",
      "text_key": "4cbdd448bf7e186970e10b6f36ad6cd378c848e14c3d66f2dc4ca64bccbb6774",
      "generation_key": "nook_narrator_999304e1503af316",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_999304e1503af316.mp3"
    },
    {

      "packet_id": "hg2_np_10_blind_choir_corner",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Children practiced the bell rhythm against bare stone.",
      "text_key": "8ad0bd79c6cd3798d19487aa5bcf33b94efe66165c4d39ff2078ad32ecee328d",
      "generation_key": "nook_narrator_c5571ad40d912444",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_c5571ad40d912444.mp3"
    },

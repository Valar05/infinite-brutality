      "packet_id": "hg_np_09_bell_blind_memorial",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Forty-one households passed before the counting stopped.",
      "text_key": "e36c718898d39032f59b8342e697cdabb246b4c30c16039e46fbb3713cd939ab",
      "generation_key": "nook_narrator_56e0e78a6463f128",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_56e0e78a6463f128.mp3"
    },
    {

      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Seven bell tongues were wrapped here, and three never returned.",
      "text_key": "df9ea25c4648469b2815ae057a7fbd6fbb40f56165886f5a0191854df8575092",
      "generation_key": "nook_narrator_9eb2a4f7789ab926",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_9eb2a4f7789ab926.mp3"
    },
    {

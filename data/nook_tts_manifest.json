      "packet_id": "hg_np_08_hidden_jar_crawlspace",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Three jars waited here for the eastward crossing.",
      "text_key": "a67d84963745a833a407e4b1fd5adc4b0c9bbf792a5bffb0b58fcdbb1ec01bbf",
      "generation_key": "nook_narrator_bebcc6e28c8bbfb7",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_bebcc6e28c8bbfb7.mp3"
    },
    {

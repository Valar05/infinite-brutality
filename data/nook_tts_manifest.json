      "packet_id": "hg2_np_03_double_seal_bench",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Every seal needed a mercy mark on the back.",
      "text_key": "a210cdce7524ee18b3cb172b4c99e2e7d21ef144b73306c6ebc7ab70344b964f",
      "generation_key": "nook_narrator_8fc004cc9a17fdd7",

      "packet_id": "hg2_np_11_linen_name_drawer",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Knotted linen meant confirmed gone, and plain linen meant wait.",
      "text_key": "33cee90afc9d1ea626d3aacccde7d2307f006aa20c1448495650433b8141c277",
      "generation_key": "nook_narrator_b8131061ab5615f4",

      "packet_id": "hg2_np_02_witness_step_school",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Children named themselves here before touching the rope.",
      "text_key": "cb9a34b501be7f484ab4090e1d707e52b00284d9d13880adf5d43b714ad0292f",
      "generation_key": "nook_narrator_b4afcf89feb6e8aa",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_b4afcf89feb6e8aa.mp3"
    },

      "packet_id": "hg_np_11_veil_stair_school",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Children pointed east before they were allowed to say it.",
      "text_key": "73cf6438d34b0f29f1e53f838daf5ed048d79dd64ee96bfe28fc91c4f865b1e0",
      "generation_key": "nook_narrator_e47ec514d0aea091",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_e47ec514d0aea091.mp3"
    },
    {

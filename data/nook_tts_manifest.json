  "clips": [
    {
      "id": "nook_tts_hg_np_01_cistern_sleep_ledge",
      "packet_id": "hg_np_01_cistern_sleep_ledge",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Children slept furthest from the edge.",
      "text_key": "9858bb099836a10327f469c6fe0364a2cb82b30f25ad669afc771e657464abf8",
      "generation_key": "nook_narrator_9381964990ba181e",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_9381964990ba181e.mp3"
    },
    {
      "id": "nook_tts_hg_np_02_lamp_shelf_shrine",
      "packet_id": "hg_np_02_lamp_shelf_shrine",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Vows were knotted here because the bridge still listened.",
      "text_key": "67771c9e25a7689524106417e73b3f9e7dbec904f2a34c7b8c087d10d00ba292",
      "generation_key": "nook_narrator_dcc03c30f075c4a6",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_dcc03c30f075c4a6.mp3"
    },
    {
      "id": "nook_tts_hg_np_03_splice_bench",
      "packet_id": "hg_np_03_splice_bench",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "East lines were repaired first and marked twice.",
      "text_key": "508a1521dfa7a462becc85d2a60d4ef5993e2ac1c87fb97af37d69d55ac765f7",
      "generation_key": "nook_narrator_87ca97a8d550e6c2",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_87ca97a8d550e6c2.mp3"
    },
    {
      "id": "nook_tts_hg_np_04_grain_wall_recess",
      "packet_id": "hg_np_04_grain_wall_recess",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "A broken grain seal meant flee east at once.",
      "text_key": "aa4a7026092d1e7cd9f9bfce7942f7b339d2f44f26fbd96d561d2a218b2c6461",
      "generation_key": "nook_narrator_4313238b815fa868",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_4313238b815fa868.mp3"
    },
    {
      "id": "nook_tts_hg_np_05_name_veil_niche",
      "packet_id": "hg_np_05_name_veil_niche",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Ages were cut in stone and names stayed veiled.",
      "text_key": "977021a81b364e671d562e9ac986a0905865ce165706ccb3eadc5f07a97dbae5",
      "generation_key": "nook_narrator_04236f8abd9f2789",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_04236f8abd9f2789.mp3"
    },
    {
      "id": "nook_tts_hg_np_06_bath_step_corner",
      "packet_id": "hg_np_06_bath_step_corner",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "Children learned the ration law on this step.",
      "text_key": "a03130bf6ea7bd89c1b492bf2ac4d372184e0c0de389806ed3f5d48a2046d13d",
      "generation_key": "nook_narrator_3593c5d1718d11ae",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_3593c5d1718d11ae.mp3"
    },
    {

      "packet_id": "hg_np_10_garden_graft_table",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "This grafting table became a splinting bench.",
      "text_key": "08d406c794ef121e187fd137bf736bee7be98b5089d33ecd4ad662f996115deb",
      "generation_key": "nook_narrator_a5ff9530a99c5bf1",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_a5ff9530a99c5bf1.mp3"
    },
    {

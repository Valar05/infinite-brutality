      "packet_id": "hg2_np_07_substitute_offering_wall",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "When offerings failed, folded names took their place.",
      "text_key": "80fc72be056a16781ba501d4e7e89df9665adf66e341398bea8617547be63e9b",
      "generation_key": "nook_narrator_335069d836289792",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_335069d836289792.mp3"
    },
    {

      "packet_id": "hg2_np_09_handprint_count_panel",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Each white handprint marks one witness.",
      "text_key": "13eef35a54349705ebe905a3fbf5e09c55dccdd47498c252321a9d6ed4322284",
      "generation_key": "nook_narrator_f18ae6379378408f",

      "packet_id": "hg_np_12_underbridge_ash_wrap",
      "pilot_id": "hanging_gardens_absent_people_01",
      "speaker_id": "nook_narrator",
      "text": "The dead were wrapped with age outside and name inside.",
      "text_key": "09d55ddd505503535ca612cf9be2dd063c454a4d961ca1d10c241fccd31cb3a2",
      "generation_key": "nook_narrator_e724d55b08620872",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_e724d55b08620872.mp3"
    },
    {

      "packet_id": "hg2_np_08_cistern_cap_table",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "Route papers to the sealed stair were kept here.",
      "text_key": "2151bd4526171d678de3ee38c6d511a92d66e230338c96c3e0e58484da69fb0c",
      "generation_key": "nook_narrator_1c3b3d253cac59de",

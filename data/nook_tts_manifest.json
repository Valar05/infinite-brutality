      "packet_id": "hg2_np_04_unblessed_water_shelf",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "These bowls stayed unblessed after the collapse.",
      "text_key": "21a2e2b4901ffc2dcd174d3f69b19aca4e6276c00d8a2704b0a7b6afdd85906b",
      "generation_key": "nook_narrator_518b9ea43b8ee59e",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_518b9ea43b8ee59e.mp3"
    },
    {

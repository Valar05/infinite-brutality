      "packet_id": "hg2_np_05_unrung_memorial_arc",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "The bell fell before any of these names were rung.",
      "text_key": "7b518952b5527c9d201ebda54108f922662ce510d917feed47b7476450592e14",
      "generation_key": "nook_narrator_495e64d13082f88a",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_495e64d13082f88a.mp3"
    },
    {

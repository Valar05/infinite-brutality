      "packet_id": "hg2_np_06_roof_curtain_cell",
      "pilot_id": "hanging_gardens_absent_people_02",
      "speaker_id": "nook_narrator",
      "text": "The last watcher left this curtain torn open.",
      "text_key": "220a93d2b78ee4b3a2d5f3ba50d33b2bae07312eecf66f4c453da224eac78c8a",
      "generation_key": "nook_narrator_af9c845c9c2452c2",
      "file": "assets/audio/generated/nook_narrator/nook_narrator_af9c845c9c2452c2.mp3"
    },
    {
